digraph FabricSalesDemoGoldOntology {
  graph [rankdir=LR, bgcolor="white", fontname="Segoe UI", label="Gold-only ontology"];
  node [shape=box, style="rounded,filled", fontname="Segoe UI", color="#107C10", fillcolor="#DFF6DD"];
  edge [fontname="Segoe UI", color="#605E5C"];

  ExecutiveSnapshot [label="Executive Snapshot\nexecutive_kpi_snapshot"];
  SalesKPI [label="Sales KPI\nmonthly_sales_summary"];
  ProductPerformance [label="Product Performance\nproduct_performance"];
  ChannelPerformance [label="Channel Performance\nchannel_performance"];
  RegionSegmentScorecard [label="Region Segment Scorecard\nregion_segment_scorecard"];
  CustomerValue [label="Customer 360\ncustomer_360"];
  CampaignROI [label="Campaign ROI\ncampaign_roi_summary"];

  ExecutiveSnapshot -> SalesKPI [label="rolls_up"];
  ExecutiveSnapshot -> CampaignROI [label="rolls_up"];
  ExecutiveSnapshot -> ProductPerformance [label="summarizes"];
  ExecutiveSnapshot -> ChannelPerformance [label="summarizes"];
  ExecutiveSnapshot -> RegionSegmentScorecard [label="summarizes"];
  SalesKPI -> ProductPerformance [label="aligns_to_product"];
  SalesKPI -> ChannelPerformance [label="aligns_to_channel"];
  SalesKPI -> RegionSegmentScorecard [label="aligns_to_region_segment"];
  CustomerValue -> RegionSegmentScorecard [label="rolls_up_to"];
}
