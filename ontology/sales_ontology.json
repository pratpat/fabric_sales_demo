{
  "name": "FabricSalesDemoGoldOntology",
  "version": "1.1.0",
  "description": "Gold-layer-only business ontology for the synthetic Marcus-style Fabric sales demo.",
  "scope": "Gold datasets only. Silver facts and dimensions are intentionally excluded from this ontology.",
  "layers": {
    "gold": "Business-ready aggregates and scorecards for executive reporting, analytics, Fabric Data Agent grounding, and Cowork integration."
  },
  "entities": [
    {
      "name": "ExecutiveSnapshot",
      "table": "executive_kpi_snapshot",
      "key": "snapshot_date",
      "attributes": ["reporting_period", "customers", "applications", "funded_sales", "sales_amount", "estimated_revenue", "conversion_rate", "campaign_conversion_rate"]
    },
    {
      "name": "SalesKPI",
      "table": "monthly_sales_summary",
      "key": "sales_month,region,segment,product_id,channel_id",
      "attributes": ["applications", "funded_sales", "sales_amount", "estimated_revenue", "new_customer_sales", "conversion_rate"]
    },
    {
      "name": "CustomerValue",
      "table": "customer_360",
      "key": "customer_id",
      "attributes": ["region", "segment", "credit_tier", "digital_engagement_score", "web_events", "funded_sales", "lifetime_sales_amount", "lifetime_estimated_revenue"]
    },
    {
      "name": "CampaignROI",
      "table": "campaign_roi_summary",
      "key": "campaign_month,campaign_id,channel",
      "attributes": ["campaign_name", "touches", "conversions", "attributed_revenue", "conversion_rate", "roi_index"]
    },
    {
      "name": "ProductPerformance",
      "table": "product_performance",
      "key": "product_id",
      "attributes": ["product_name", "product_family", "applications", "funded_sales", "sales_amount", "estimated_revenue", "average_funded_sale", "conversion_rate", "new_customer_mix"]
    },
    {
      "name": "ChannelPerformance",
      "table": "channel_performance",
      "key": "sales_month,channel_id",
      "attributes": ["channel_name", "channel_group", "applications", "funded_sales", "sales_amount", "estimated_revenue", "conversion_rate"]
    },
    {
      "name": "RegionSegmentScorecard",
      "table": "region_segment_scorecard",
      "key": "region,segment",
      "attributes": ["customers", "average_engagement_score", "applications", "funded_sales", "sales_amount", "estimated_revenue", "conversion_rate", "revenue_per_customer"]
    }
  ],
  "relationships": [
    {"from": "ExecutiveSnapshot.reporting_period", "to": "SalesKPI.sales_month", "relationship": "rolls_up", "cardinality": "one-to-many-summary"},
    {"from": "ExecutiveSnapshot.reporting_period", "to": "CampaignROI.campaign_month", "relationship": "rolls_up", "cardinality": "one-to-many-summary"},
    {"from": "ExecutiveSnapshot.snapshot_date", "to": "ProductPerformance.product_id", "relationship": "summarizes", "cardinality": "one-to-many-summary"},
    {"from": "ExecutiveSnapshot.reporting_period", "to": "ChannelPerformance.sales_month", "relationship": "summarizes", "cardinality": "one-to-many-summary"},
    {"from": "ExecutiveSnapshot.snapshot_date", "to": "RegionSegmentScorecard.region,segment", "relationship": "summarizes", "cardinality": "one-to-many-summary"},
    {"from": "SalesKPI.product_id", "to": "ProductPerformance.product_id", "relationship": "aligns_to_product", "cardinality": "many-to-one-summary"},
    {"from": "SalesKPI.sales_month,channel_id", "to": "ChannelPerformance.sales_month,channel_id", "relationship": "aligns_to_channel", "cardinality": "many-to-one-summary"},
    {"from": "SalesKPI.region,segment", "to": "RegionSegmentScorecard.region,segment", "relationship": "aligns_to_region_segment", "cardinality": "many-to-one-summary"},
    {"from": "CustomerValue.region,segment", "to": "RegionSegmentScorecard.region,segment", "relationship": "rolls_up_to", "cardinality": "many-to-one-summary"}
  ],
  "metrics": [
    {
      "name": "Applications",
      "definition": "Gold-level count of applications represented in monthly sales aggregates.",
      "dax": "Applications = SUM(gold_monthly_sales_summary[applications])"
    },
    {
      "name": "Funded Sales",
      "definition": "Gold-level count of funded sales.",
      "dax": "Funded Sales = SUM(gold_monthly_sales_summary[funded_sales])"
    },
    {
      "name": "Sales Amount",
      "definition": "Total funded sales balance or funded volume.",
      "dax": "Sales Amount = SUM(gold_monthly_sales_summary[sales_amount])"
    },
    {
      "name": "Estimated Revenue",
      "definition": "Modeled revenue from funded sales using product revenue assumptions.",
      "dax": "Estimated Revenue = SUM(gold_monthly_sales_summary[estimated_revenue])"
    },
    {
      "name": "Conversion Rate",
      "definition": "Funded sales divided by applications.",
      "dax": "Conversion Rate = DIVIDE([Funded Sales], [Applications])"
    },
    {
      "name": "Campaign ROI Index",
      "definition": "Attributed revenue divided by modeled campaign touch cost.",
      "dax": "Campaign ROI Index = DIVIDE(SUM(gold_campaign_roi_summary[attributed_revenue]), SUM(gold_campaign_roi_summary[touches]) * 7.5)"
    }
  ],
  "goldTables": [
    "executive_kpi_snapshot",
    "monthly_sales_summary",
    "product_performance",
    "channel_performance",
    "region_segment_scorecard",
    "campaign_roi_summary",
    "customer_360"
  ],
  "graphArtifacts": [
    "ontology/sales_ontology_graph.mmd",
    "ontology/sales_ontology_graph.dot",
    "ontology/sales_ontology_graph.excalidraw",
    "data/ontology/graph_nodes.csv",
    "data/ontology/graph_edges.csv"
  ]
}
